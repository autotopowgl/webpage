---
import '../styles/global.css';
import { contenido } from '../lib/contenido';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: '/';
}
const { titulo, descripcion, ruta } = Astro.props;
const { marca, contacto } = contenido;
const canonical = new URL(ruta, marca.dominio).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="nav" data-testid="nav">
      <div class="container nav__inner">
        <a class="nav__logo" href="/" aria-label={`${marca.nombre}, inicio`}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="var(--c-accent)"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5" stroke="currentColor" stroke-width="2"/></svg>
          <span>Auto<strong>Topo</strong></span>
        </a>
        <nav aria-label="Principal" class="nav__links">
          <a href="/#como-opera" class="nav__link nav__link--sec">Servicio</a>
          <a href="/#tecnologia" class="nav__link nav__link--sec">Tecnología</a>
          <a href="/#equipo" class="nav__link nav__link--sec">Equipo</a>
          <a href="/#contacto" class="nav__link nav__link--cta" data-testid="nav-piloto">Contacto</a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer__inner">
        <p><strong>{marca.nombre}</strong>: {marca.lema}</p>
        <p class="muted">Empresa en formación · Ingeniería robótica hecha en Chile · <a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></p>
        <p class="muted">© {new Date().getFullYear()} {marca.nombre}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--c-accent); color: var(--c-accent-ink); padding: 8px 12px; }
  .skip:focus { left: 8px; top: 8px; }
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(13, 17, 23, 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--c-border); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); gap: var(--sp-3); }
  .nav__logo { display: inline-flex; align-items: center; gap: var(--sp-2); color: var(--c-text); text-decoration: none; font-size: var(--fs-lg); letter-spacing: -0.01em; }
  .nav__logo strong { color: var(--c-accent); }
  .nav__links { display: flex; gap: var(--sp-2); align-items: center; }
  .nav__link { color: var(--c-text); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); padding: 8px 12px; border-radius: 999px; min-height: 40px; display: inline-flex; align-items: center; }
  .nav__link:hover { color: var(--c-accent-strong); }
  .nav__link--cta { border: 1px solid var(--c-accent); color: var(--c-accent-strong); }
  .nav__link--sec { display: none; }
  @media (min-width: 700px) { .nav__link--sec { display: inline-flex; } }
  .footer { border-top: 1px solid var(--c-border); padding-block: var(--sp-6); font-size: var(--fs-sm); }
  .footer p { margin-bottom: var(--sp-2); }
</style>
