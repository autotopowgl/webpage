---
// D4/D5: foto real, video YouTube diferido o esquema ilustrado como fallback.
import EsquemaRover from './EsquemaRover.astro';
import EsquemaFlujo from './EsquemaFlujo.astro';
import { idYouTube } from '../lib/enlaces';

interface Props {
  src?: string;
  alt: string;
  esquema?: 'rover' | 'flujo' | 'ninguno';
  avisoVideo?: string;
}
const { src = '', alt, esquema = 'rover', avisoVideo } = Astro.props;
const yt = src ? idYouTube(src) : null;
const tipo = yt ? 'video' : src ? 'foto' : avisoVideo && esquema === 'ninguno' ? 'aviso' : 'esquema';
---
<figure class="media" data-media-tipo={tipo}>
  {tipo === 'video' && (
    <div class="media__video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${yt}`}
        title={alt}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  )}
  {tipo === 'foto' && <img src={src} alt={alt} loading="lazy" decoding="async" />}
  {tipo === 'esquema' && (esquema === 'flujo' ? <EsquemaFlujo /> : <EsquemaRover titulo={alt} />)}
  {tipo === 'aviso' && (
    <div class="media__aviso" role="note">
      <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 8l6 4-6 4z" fill="var(--c-accent)"/></svg>
      <p><strong>Video próximamente</strong></p>
      <p class="muted">{avisoVideo}</p>
    </div>
  )}
  {tipo === 'esquema' && <figcaption class="muted">Ilustración esquemática</figcaption>}
</figure>

<style>
  .media { margin: 0; background: var(--c-bg-alt); border: 1px solid var(--c-border); border-radius: var(--radius); padding: var(--sp-4); min-width: 0; }
  .media img { width: 100%; height: auto; border-radius: var(--radius-sm); }
  .media__video { position: relative; aspect-ratio: 16 / 9; }
  .media__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: var(--radius-sm); }
  .media__aviso { aspect-ratio: 16 / 9; display: grid; place-content: center; text-align: center; gap: var(--sp-1); justify-items: center; }
  .media__aviso p { margin: 0; }
  figcaption { font-size: var(--fs-xs); margin-top: var(--sp-2); text-align: right; }
</style>
