---
import Layout from '../components/Layout.astro';
import Media from '../components/Media.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import Contacto from '../components/Contacto.astro';
import { contenido } from '../lib/contenido';

const { marca, cifras, hero, problema, pasos, comparacion, tecnologia, impacto, equipo, media, videos } = contenido;
const heroCifras = [
  { valor: cifras.puntosDia, etiqueta: 'puntos por día' },
  { valor: cifras.precision, etiqueta: 'precisión RTK' },
  { valor: cifras.capex, etiqueta: 'CAPEX · 100% OPEX' },
];
---
<Layout
  titulo={`${marca.nombre} · Replanteo topográfico autónomo para parques solares`}
  descripcion={marca.descripcion}
  ruta="/"
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-titulo" data-testid="hero">
    <div class="container hero__grid">
      <div class="hero__texto">
        <span class="eyebrow">Robotics-as-a-Service · Energía solar</span>
        <h1 id="hero-titulo" data-testid="hero-titulo">{hero.titulo}</h1>
        <ul class="hero__cifras" data-testid="hero-cifras">
          {heroCifras.map((c) => (
            <li><strong>{c.valor}</strong><span>{c.etiqueta}</span></li>
          ))}
        </ul>
        <div class="hero__cta">
          <CtaWhatsApp texto={hero.cta} contexto="piloto" testid="cta-hero" />
        </div>
        <p class="hero__bajada">{hero.bajada}</p>
      </div>
      <div class="hero__media">
        <Media src={media.hero} alt="Ilustración del rover AutoTopo marcando puntos de hincado con precisión RTK" esquema="rover" />
      </div>
    </div>
  </section>

  <!-- PROBLEMA -->
  <section class="section section--alt" id="problema" aria-labelledby="problema-titulo" data-seccion="problema">
    <div class="container">
      <span class="eyebrow">El problema</span>
      <h2 id="problema-titulo">{problema.titulo}</h2>
      <p class="lead">{problema.bajada}</p>
      <div class="grid grid--3 problema__items">
        {problema.items.map((i) => (
          <div class="card stat">
            <strong class="stat__cifra">{i.cifra}</strong>
            <p>{i.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO OPERA -->
  <section class="section" id="como-opera" aria-labelledby="opera-titulo" data-seccion="como-opera">
    <div class="container">
      <span class="eyebrow">Cómo opera en faena</span>
      <h2 id="opera-titulo">De plano a terreno en 3 pasos</h2>
      <div class="flujo-wrap"><Media alt="Flujo de operación" esquema="flujo" /></div>
      <ol class="grid grid--3 pasos">
        {pasos.map((p, i) => (
          <li class="card paso">
            <span class="paso__n" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p class="muted">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- COMPARACION -->
  <section class="section section--sand" id="comparacion" aria-labelledby="comp-titulo" data-seccion="comparacion">
    <div class="container">
      <span class="eyebrow">Ventajas del modelo RaaS</span>
      <h2 id="comp-titulo">{comparacion.titulo}</h2>
      <table class="comp" data-testid="comparacion">
        <thead>
          <tr><th scope="col">Criterio</th><th scope="col">Cuadrilla manual</th><th scope="col" class="comp__auto">AutoTopo RaaS</th></tr>
        </thead>
        <tbody>
          {comparacion.filas.map((f) => (
            <tr>
              <th scope="row">{f.criterio}</th>
              <td data-label="Cuadrilla manual">{f.manual}</td>
              <td data-label="AutoTopo RaaS" class="comp__auto">{f.autotopo}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="comp__cta"><CtaWhatsApp texto={hero.cta} contexto="piloto" /></div>
    </div>
  </section>

  <!-- TECNOLOGIA -->
  <section class="section" id="tecnologia" aria-labelledby="tec-titulo" data-seccion="tecnologia">
    <div class="container">
      <span class="eyebrow">Respaldo I+D</span>
      <h2 id="tec-titulo">{tecnologia.titulo}</h2>
      <p class="lead">{tecnologia.bajada}</p>
      <div class="tec__grid">
        <Media
          src={videos.mvp || media.tecnologia}
          alt="Video demostrativo del rover AutoTopo en operación"
          esquema="rover"
        />
        <ul class="tec__items">
          {tecnologia.items.map((t) => (
            <li><h3>{t.titulo}</h3><p class="muted">{t.texto}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- IMPACTO -->
  <section class="section section--alt" id="impacto" aria-labelledby="imp-titulo" data-seccion="impacto">
    <div class="container">
      <span class="eyebrow">Estándar HSE · Sostenibilidad</span>
      <h2 id="imp-titulo">{impacto.titulo}</h2>
      <p class="lead">{impacto.bajada}</p>
      <ul class="ods" aria-label="Objetivos de Desarrollo Sostenible">
        {impacto.ods.map((o) => (
          <li class="ods__item"><span class="ods__n">ODS {o.numero}</span><span>{o.nombre}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- EQUIPO -->
  <section class="section" id="equipo" aria-labelledby="eq-titulo" data-seccion="equipo">
    <div class="container">
      <span class="eyebrow">Quiénes somos</span>
      <h2 id="eq-titulo">{equipo.titulo} <span class="badge badge--accent" data-testid="female-led">Female-led</span></h2>
      <p class="lead">{equipo.bajada}</p>
      <ul class="grid grid--3 equipo">
        {equipo.personas.map((p) => (
          <li class="card persona">
            <span class="persona__avatar" aria-hidden="true">{p.iniciales}</span>
            <div><h3>{p.nombre}</h3><p class="muted">{p.rol}</p></div>
          </li>
        ))}
      </ul>
      <aside class="ignite-banner" data-testid="banner-ignite">
        <div>
          <strong>Postulación Start-Up Chile Ignite · CORFO</strong>
          <p class="muted">Hoja de ruta, KPIs del programa, mercado y aporte al ecosistema chileno.</p>
        </div>
        <a class="btn btn--ghost" href="/ignite/" data-testid="link-ignite-respaldo">Ver presentación Ignite →</a>
      </aside>
    </div>
  </section>

  <Contacto
    contexto="piloto"
    titulo="Probemos AutoTopo en su faena"
    bajada="Coordinemos un piloto operativo en su parque solar. Le respondemos directamente por WhatsApp o por correo."
    cta={hero.cta}
  />
</Layout>

<style>
  .hero { padding-block: var(--sp-5) var(--sp-7); background: radial-gradient(120% 80% at 100% 0%, rgba(245, 166, 35, 0.14), transparent 60%), var(--c-bg); }
  .hero__grid { display: grid; gap: var(--sp-6); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 900px) { .hero { padding-block: var(--sp-8); } .hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } }
  .hero h1 { font-size: var(--fs-hero); margin-bottom: var(--sp-4); }
  .hero__cifras { list-style: none; padding: 0; margin: 0 0 var(--sp-4); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2); }
  .hero__cifras li { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-sm); padding: var(--sp-2) var(--sp-3); display: grid; min-width: 0; }
  .hero__cifras strong { font-size: clamp(1.15rem, 4vw, 1.75rem); color: var(--c-data); line-height: 1.2; }
  .hero__cifras span { font-size: 0.75rem; color: var(--c-text-muted); line-height: 1.3; }
  .hero__cta { margin-bottom: var(--sp-4); }
  .hero__cta .btn { width: 100%; }
  @media (min-width: 560px) { .hero__cta .btn { width: auto; } }
  .hero__bajada { color: var(--c-text-muted); }
  @media (max-width: 380px) { .hero h1 { font-size: 1.6rem; } .eyebrow { margin-bottom: var(--sp-2); } }

  .problema__items { margin-top: var(--sp-5); }
  .stat__cifra { display: block; font-size: var(--fs-xl); color: var(--c-accent-strong); margin-bottom: var(--sp-1); }

  .flujo-wrap { margin-block: var(--sp-5); }
  .pasos { list-style: none; padding: 0; margin: 0; }
  .paso { position: relative; }
  .paso__n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--c-accent); color: var(--c-accent-ink); font-weight: 800; margin-bottom: var(--sp-3); }

  .comp { width: 100%; border-collapse: collapse; margin-top: var(--sp-5); background: #fffaf2; border-radius: var(--radius); overflow: hidden; border: 1px solid #e3d8c5; }
  .comp th, .comp td { padding: var(--sp-3) var(--sp-4); text-align: left; vertical-align: top; border-bottom: 1px solid #e9dfcf; }
  .comp thead th { background: #efe5d4; font-size: var(--fs-sm); }
  .comp .comp__auto { background: rgba(245, 166, 35, 0.12); font-weight: 600; }
  .comp thead .comp__auto { background: var(--c-accent); color: var(--c-accent-ink); }
  @media (max-width: 699px) {
    .comp thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .comp, .comp tbody, .comp tr, .comp th, .comp td { display: block; width: 100%; }
    .comp tr { border-bottom: 1px solid #e3d8c5; padding: var(--sp-3) 0; }
    .comp tbody th { border: 0; padding-bottom: var(--sp-1); color: #7f4f00; text-transform: uppercase; font-size: var(--fs-xs); letter-spacing: 0.08em; }
    .comp td { border: 0; padding-block: var(--sp-1); }
    .comp td::before { content: attr(data-label) ': '; font-weight: 700; display: block; font-size: var(--fs-xs); color: var(--c-sand-muted); }
    .comp .comp__auto { background: transparent; }
    .comp td.comp__auto::before { color: #7f4f00; }
  }
  .comp__cta { margin-top: var(--sp-5); text-align: center; }

  .tec__grid { display: grid; gap: var(--sp-5); grid-template-columns: minmax(0, 1fr); margin-top: var(--sp-5); align-items: start; }
  @media (min-width: 900px) { .tec__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .tec__items { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .tec__items li { border-left: 3px solid var(--c-data); padding-left: var(--sp-4); }
  .tec__items h3 { font-size: var(--fs-md); margin-bottom: var(--sp-1); }
  .tec__items p { margin: 0; font-size: var(--fs-sm); }

  .ods { list-style: none; padding: 0; margin: var(--sp-5) 0 0; display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .ods__item { display: flex; flex-direction: column; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-sm); padding: var(--sp-3) var(--sp-4); flex: 1 1 150px; min-width: 0; }
  .ods__n { font-weight: 800; color: var(--c-data); }

  .equipo { list-style: none; padding: 0; margin: var(--sp-5) 0 0; }
  .persona { display: flex; gap: var(--sp-4); align-items: center; }
  .persona h3 { margin: 0; font-size: var(--fs-md); }
  .persona p { margin: 0; font-size: var(--fs-sm); }
  .persona__avatar { flex: none; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; background: linear-gradient(135deg, var(--c-accent), #e07b00); color: var(--c-accent-ink); }
  h2 .badge { vertical-align: middle; margin-left: var(--sp-2); }

  .ignite-banner { margin-top: var(--sp-6); display: flex; flex-wrap: wrap; gap: var(--sp-4); align-items: center; justify-content: space-between; padding: var(--sp-5); border: 1px dashed var(--c-accent); border-radius: var(--radius); background: rgba(245, 166, 35, 0.06); }
  .ignite-banner p { margin: var(--sp-1) 0 0; font-size: var(--fs-sm); }
</style>
